{
  "name": "@memory-chess/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Server-authoritative multiplayer Memory Chess",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "dev:demo": "node scripts/dev-memory-db.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:unit": "node --test test/rules.test.js",
    "test:integration": "node --test test/integration.test.js",
    "test:engine": "node --test test/stockfish.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "chess.js": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1",
    "socket.io": "^4.8.1",
    "stockfish": "19.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.2.1",
    "socket.io-client": "^4.8.1"
  }
}
