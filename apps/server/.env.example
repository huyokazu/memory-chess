PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/memory_chess?replicaSet=rs0&directConnection=true
# Replace with at least 32 random characters before starting the server.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
CLIENT_ORIGINS=http://localhost:8081,http://localhost:19006
PUBLIC_CLIENT_URL=http://localhost:8081
MAX_BOT_GAMES=4
NODE_ENV=development
# Enable after pnpm build:web to serve the browser app from this server.
SERVE_WEB=false
# Number of trusted reverse proxies; Render uses 1. Keep 0 locally.
TRUST_PROXY_HOPS=0
